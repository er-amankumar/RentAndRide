```html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Rent & Ride - Dashboard</title>

    <link rel="stylesheet" href="../css/user.dashboard.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>

<body>

<div class="dashboard">

    <!-- ================= SIDEBAR ================= -->

    <aside class="sidebar">

        <div class="logo">
            <div class="logo-icon">R</div>

            <div>
                <h2>Rent<span>&</span>Ride</h2>
                <p>Drive Anywhere. Rent Anytime.</p>
            </div>
        </div>


        <nav>

            <p class="menu-title">MAIN MENU</p>

            <a href="#" class="menu active">
                <span>⌂</span>
                Dashboard
            </a>

            <a href="#" class="menu">
                <span>🚗</span>
                Browse Vehicles
            </a>

            <a href="#" class="menu">
                <span>📋</span>
                My Bookings
            </a>

            <a href="#" class="menu">
                <span>♡</span>
                Wishlist
            </a>


            <p class="menu-title account-title">ACCOUNT</p>

            <a href="#" class="menu">
                <span>👤</span>
                Profile
            </a>

            <a href="#" class="menu">
                <span>⚙</span>
                Settings
            </a>

        </nav>


        <div class="sidebar-bottom">

            <div class="help-box">

                <div class="help-icon">?</div>

                <div>
                    <strong>Need Help?</strong>
                    <p>Contact support</p>
                </div>

            </div>

            <a href="/logout" class="logout">
                ↪ &nbsp; Logout
            </a>

        </div>

    </aside>


    <!-- ================= MAIN ================= -->

    <main class="main">

        <!-- TOP NAVBAR -->

        <header class="topbar">

            <div class="search">

                <span>⌕</span>

                <input
                    type="text"
                    placeholder="Search vehicles, bookings..."
                >

            </div>


            <div class="top-right">

                <button class="notification">
                    🔔
                    <i></i>
                </button>


                <div class="user">

                    <div class="avatar">
                        A
                    </div>

                    <div class="user-info">
                        <strong>Aman Kumar</strong>
                        <small>Customer</small>
                    </div>

                    <span>⌄</span>

                </div>

            </div>

        </header>


        <!-- CONTENT -->

        <section class="content">


            <!-- WELCOME -->

            <div class="welcome">

                <div>

                    <p class="small-title">
                        USER DASHBOARD
                    </p>

                    <h1>
                        Good to see you, Aman 👋
                    </h1>

                    <p class="subtitle">
                        Manage your rides, bookings and account from here.
                    </p>

                </div>


                <a href="#" class="rent-btn">
                    + Rent a Vehicle
                </a>

            </div>


            <!-- ================= STAT CARDS ================= -->

            <div class="stats">


                <div class="stat-card">

                    <div class="stat-icon blue">
                        📋
                    </div>

                    <div>

                        <p>Total Bookings</p>

                        <h2>12</h2>

                        <small class="green-text">
                            ↑ 8.2%
                        </small>

                        <small>
                            vs last month
                        </small>

                    </div>

                </div>


                <div class="stat-card">

                    <div class="stat-icon green">
                        🚗
                    </div>

                    <div>

                        <p>Active Booking</p>

                        <h2>01</h2>

                        <small>
                            Currently rented
                        </small>

                    </div>

                </div>


                <div class="stat-card">

                    <div class="stat-icon orange">
                        ₹
                    </div>

                    <div>

                        <p>Total Spent</p>

                        <h2>₹18,450</h2>

                        <small class="green-text">
                            ↑ 4.5%
                        </small>

                        <small>
                            vs last month
                        </small>

                    </div>

                </div>


                <div class="stat-card">

                    <div class="stat-icon purple">
                        ★
                    </div>

                    <div>

                        <p>Reward Points</p>

                        <h2>850</h2>

                        <small>
                            Available points
                        </small>

                    </div>

                </div>


            </div>


            <!-- ================= GRID ================= -->

            <div class="dashboard-grid">


                <!-- ACTIVE RENTAL -->

                <div class="card active-rental">

                    <div class="card-header">

                        <div>

                            <h3>Active Rental</h3>

                            <p>Your current ride</p>

                        </div>

                        <span class="status">
                            ● Active
                        </span>

                    </div>


                    <div class="car">

                        <div class="car-image">
                            🚘
                        </div>

                        <div class="car-info">

                            <h2>
                                Hyundai Creta
                            </h2>

                            <p>
                                Automatic • Petrol
                            </p>

                            <div class="car-details">

                                <div>
                                    <small>Pickup</small>
                                    <strong>Oct 04, 10:00 AM</strong>
                                </div>

                                <div>
                                    <small>Return</small>
                                    <strong>Oct 06, 10:00 AM</strong>
                                </div>

                            </div>

                        </div>

                    </div>


                    <div class="rental-footer">

                        <div>

                            <small>Total Amount</small>

                            <strong>₹4,200</strong>

                        </div>

                        <a href="#">
                            View Booking →
                        </a>

                    </div>

                </div>


                <!-- QUICK ACTIONS -->

                <div class="card">

                    <div class="card-header">

                        <div>

                            <h3>Quick Actions</h3>

                            <p>Get things done faster</p>

                        </div>

                    </div>


                    <div class="quick-actions">


                        <a href="#">

                            <div class="quick-icon">
                                🚗
                            </div>

                            <div>

                                <strong>Find a Vehicle</strong>

                                <small>
                                    Search cars & bikes
                                </small>

                            </div>

                            <b>→</b>

                        </a>


                        <a href="#">

                            <div class="quick-icon">
                                📋
                            </div>

                            <div>

                                <strong>My Bookings</strong>

                                <small>
                                    Manage your rides
                                </small>

                            </div>

                            <b>→</b>

                        </a>


                        <a href="#">

                            <div class="quick-icon">
                                👤
                            </div>

                            <div>

                                <strong>Verify Licence</strong>

                                <small>
                                    Complete your profile
                                </small>

                            </div>

                            <b>→</b>

                        </a>


                    </div>

                </div>

            </div>


            <!-- ================= RECENT BOOKINGS ================= -->

            <div class="card recent">

                <div class="card-header">

                    <div>

                        <h3>Recent Bookings</h3>

                        <p>Your latest rental activity</p>

                    </div>

                    <a href="#" class="view-all">
                        View All →
                    </a>

                </div>


                <div class="table-container">

                    <table>

                        <thead>

                            <tr>

                                <th>VEHICLE</th>

                                <th>DATE</th>

                                <th>DURATION</th>

                                <th>AMOUNT</th>

                                <th>STATUS</th>

                                <th></th>

                            </tr>

                        </thead>


                        <tbody>


                            <tr>

                                <td>

                                    <div class="vehicle">

                                        <div class="vehicle-img">
                                            🚗
                                        </div>

                                        <div>
                                            <strong>
                                                Hyundai Creta
                                            </strong>

                                            <small>
                                                Automatic
                                            </small>
                                        </div>

                                    </div>

                                </td>

                                <td>
                                    Oct 01, 2026
                                </td>

                                <td>
                                    2 Days
                                </td>

                                <td>
                                    <strong>
                                        ₹4,200
                                    </strong>
                                </td>

                                <td>
                                    <span class="completed">
                                        Completed
                                    </span>
                                </td>

                                <td>
                                    ⋮
                                </td>

                            </tr>


                            <tr>

                                <td>

                                    <div class="vehicle">

                                        <div class="vehicle-img">
                                            🏍️
                                        </div>

                                        <div>

                                            <strong>
                                                Royal Enfield Classic
                                            </strong>

                                            <small>
                                                350cc
                                            </small>

                                        </div>

                                    </div>

                                </td>

                                <td>
                                    Sep 24, 2026
                                </td>

                                <td>
                                    1 Day
                                </td>

                                <td>
                                    <strong>
                                        ₹1,200
                                    </strong>
                                </td>

                                <td>
                                    <span class="completed">
                                        Completed
                                    </span>
                                </td>

                                <td>
                                    ⋮
                                </td>

                            </tr>


                            <tr>

                                <td>

                                    <div class="vehicle">

                                        <div class="vehicle-img">
                                            🚙
                                        </div>

                                        <div>

                                            <strong>
                                                Tata Nexon
                                            </strong>

                                            <small>
                                                Manual
                                            </small>

                                        </div>

                                    </div>

                                </td>

                                <td>
                                    Sep 18, 2026
                                </td>

                                <td>
                                    3 Days
                                </td>

                                <td>
                                    <strong>
                                        ₹5,850
                                    </strong>

                                </td>

                                <td>
                                    <span class="cancelled">
                                        Cancelled
                                    </span>
                                </td>

                                <td>
                                    ⋮
                                </td>

                            </tr>


                        </tbody>

                    </table>

                </div>

            </div>


            <!-- ================= TIP ================= -->

            <div class="tip">

                <div class="tip-icon">
                    ✦
                </div>

                <div>

                    <h3>
                        Ride smarter with Rent & Ride
                    </h3>

                    <p>
                        Complete your profile and driving licence
                        verification to make bookings faster and safer.
                    </p>

                </div>

                <a href="#">
                    Complete Profile →
                </a>

            </div>


        </section>

    </main>

</div>

</body>
</html>
```
