<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>change Password</title>
    <link rel="stylesheet" href="./css/register.css">
</head>
<body>
    <div class="hero">
        <div id="register">
            <div class="logo">
                <img src="../images/logo.png" alt="logo">
            </div>
            <div>
    <form action="changePassword" method="post" id="changepasswordForm">
        <p id="errorMessage" style="text-align: center;"></p>
        <label for="">email</label>
        <input type="email" name="email" readonly id="email" value="<%= email %>">
        <br>
        <label for="">New password</label>
        <input type="password" name="password" id="password"> <br>
        <label for="">Re-enter password</label>
        <input type="password" name="repassword" id="repassword">
        <input type="submit" name="" id="submit">
    </form>
    </div>

    <script src="./js/forgotPassword.js" defer></script>
</body>
</html>