<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title> Forgot password</title>
    <link rel="stylesheet" href="./css/register.css">
</head>
<body>
     <div class="hero">
        <div id="register">
            <div class="logo">
                <img src="../images/logo.png" alt="logo">
            </div>
            <div>
    <form action="" method="post" id="forgotForm">
        <!-- enter name : <input type="text" name="name" id=""><br> -->
         <p id="errorMessage" style="text-align: center;"></p>
        Enter email : <input type="email" name="email" id="email" placeholder="Enter Email"><br>
        <div id="otpSection" style="display: none;">
         Enter OTP: <input type="text"  name="otp" id="otp" placeholder="Enter OTP" maxlength="6" minlength="6"><br>
         <button type="submit" class="submit">Resend OTP</button>
         <button id="otpVerify" type="button" style="display: none;">Verify OTP</button>
         </div>
        <input id="submit" type="submit">
        
    </form>
     </div>
    </div>
    </div>

    <script src="./js/forgotPassword.js" defer></script>
</body>
</html>